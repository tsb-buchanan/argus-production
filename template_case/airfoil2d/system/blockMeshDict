boundary
(
    inlet    { type patch; faces ((0 4 7 3)); }
    outlet   { type patch; faces ((1 2 6 5)); }
    farfield { type patch; faces ((0 3 2 1)(4 5 6 7)); }   // bottom + top
    front    { type patch; faces ((0 1 5 4)); }   // y=0 plane; becomes empty after extrude
