convertToMeters 1;
vertices
(
    (-17 0     -17) (25.5 0     -17) (25.5 0.425 -17) (-17 0.425 -17)
    (-17 0      17) (25.5 0      17) (25.5 0.425  17) (-17 0.425  17)
